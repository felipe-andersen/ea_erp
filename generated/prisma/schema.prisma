generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./sqlite.db"
  // directUrl = env("DIRECT_URL")
}

model User {
  publicId            String                @default(cuid())
  id                  String                @id @default(cuid())
  tenanteId           String?
  lastName            String?
  firstName           String
  taxId               String?               @unique
  updatedAt           DateTime?             @default(now()) @updatedAt
  createdAt           DateTime?             @default(now())
  authEmail           String                @unique
  userStatus          UserStatus?           @default(ACTIVE)
  statusNotes         String?               @default("")
  authPhone           String?
  emailConfirmedAt    DateTime?
  phoneConfirmedAt    DateTime?
  authUserId          String?               @unique
  cart                Cart[]
  favorite            Favorite[]
  orderCharge         OrderCharge[]
  purchasedExperience PurchasedExperience[]
  purchasedTicket     PurchasedTicket[]
  review              Review[]
  suportTicket        SuportTicket[]
  userEmail           UserEmail[]
  userPhone           UserPhone[]
  userType            UserType?
  accountSettings     AccountSettings?
  docs                String?

  @@index([publicId])
}

model Employee {
  id          String    @id @default(cuid())
  role        Role?
  permissions String
  staffSince  DateTime?

  userType UserType?
}

model Customer {
  id String @id @default(cuid())

  // email      String?  
  // phone      String?
  // lastName            String?
  // firstName           String
  permissions   String?
  customerSince DateTime?

  userType UserType?
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model UserType {
  id     String @id @default(uuid())
  userId String @unique

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId, employeeId])
  @@index([userId])
}

enum Role {
  // OWNER
  ADMIN
  EMPLOYEE
}

model Cart {
  id            String        @id @default(cuid())
  updatedAt     DateTime      @default(now()) @updatedAt
  userId        String
  Coupons       String?
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem      CartItem[]
  OrderCharge   OrderCharge[]
  Coupon        Coupon[]
  totalDiscount Decimal?

  @@index([userId])
}

model CartItem {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  cardId        String
  coupons       Coupon[]
  totalDiscount Decimal
  //couponId  String? 
  Cart          Cart     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  //Coupon    Coupon?  @relation(fields: [couponId], references: [id])

  @@index([cardId])
}

model Company {
  id             String           @id @default(cuid())
  nickName       String           @unique
  name           String
  documentCode   String?
  documentType   String?
  // email          String
  website        String
  logoUrl        String?
  createdAt      DateTime?
  companyEmail   CompanyEmail[]
  updatedAt      DateTime         @default(now()) @updatedAt
  CompanyAddress CompanyAddress[]
  CompanyPhone   CompanyPhone[]
  Experience     Experience[]

  @@unique([documentCode, documentType])
  @@index([id, nickName])
}

model CompanyAddress {
  id                String   @id @default(cuid())
  street            String
  number            String
  complement        String?
  region            String?
  city              String
  state             String
  country           String
  postalCode        String?
  latitudeLongitude String?
  updatedAt         DateTime
  companyId         String
  Company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyPhone {
  id         String           @id @default(cuid())
  contryCode String
  areaCode   String
  number     String           @unique
  type       CompanyEmailType @unique @default(GENERAL)
  updatedAt  DateTime         @default(now()) @updatedAt
  companyId  String
  Company    Company          @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum companyPhoneType {
  GENERAL
  SUPPORT
  SALES
  INFO
}

model CompanyEmail {
  id        String           @id @default(cuid())
  email     String           @unique
  type      CompanyEmailType @default(GENERAL)
  updatedAt DateTime         @default(now()) @updatedAt
  createdAt DateTime         @default(now())
  companyId String
  Company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // @@unique([email])
  // @@unique([type])

  @@index([companyId])
}

enum CompanyEmailType {
  GENERAL
  SUPPORT
  SALES
  INFO
  NOREPLY
}

model Coupon {
  id                 String            @id @default(cuid())
  code               String
  description        String?
  discountYype       DiscountType
  discountPercentage Int?
  discountValue      Decimal?
  usageLimit         Int?
  perUserLimit       Int?
  minimumOrderValue  Decimal
  startsAt           DateTime
  expiresAt          DateTime
  isActive           Boolean
  createdAt          DateTime          @default(now())
  Cart               Cart[]
  CartItem           CartItem[]
  tags               String?
  purchasedTicket    PurchasedTicket[]
}

model Experience {
  id                  String                @id @default(cuid())
  slug                String                @unique
  title               String
  description         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  publicatedAt        DateTime?
  companyId           String
  information         String                @default("")
  includes            String                @default("{}")
  notIncludes         String                @default("{}")
  itinerary           String?               @default("{}")
  rules               String                @default("{}")
  notes               String?
  daysAndTimes        String?               @default("{}")
  prices              String                @default("{}")
  availableTickets    Int                   @default(0)
  // remainingTickets   Int      @default(0)
  // soldTickets        Int      @default(0)
  maxPerUser          Int                   @default(1)
  minPerUser          Int                   @default(1)
  disabled            Boolean               @default(false)
  imgList             String?               @default("[]")
  locations           String?               @default("[]")
  achievements        String?               @default("[]")
  purchasedExperience PurchasedExperience[]
  purchasedTicket     PurchasedTicket[]
  TicketForSale       TicketForSale[]
  favorite            Favorite[]
  Company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  experienceAddress   ExperienceAddress[]
  experience_img      Experience_img[] //imgList

  @@index([slug])
  @@index([companyId])
}

// enum AvailableDays {
//   timeZone = string,
//   availabilityDay = Date
//   timeStar = string              
//   timeEnd = string               
//   disabled = boolean
//   notes = string 
// }

model ExperienceAddress {
  id           String     @id @default(cuid())
  street       String
  number       String
  complement   String?
  region       String?
  city         String
  state        String
  country      String
  postalCode   String?
  longitude    String?
  latitude     String?
  updatedAt    DateTime
  experienceId String
  Experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Experience_img {
  id           String     @id @default(cuid())
  imageUrl     String
  altText      String?
  description  String?
  position     String
  updatedAt    DateTime   @default(now()) @updatedAt
  createdAt    DateTime   @default(now())
  experienceId String
  Experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Favorite {
  id           String     @id @default(cuid())
  added_at     DateTime
  experienceId String
  userId       String
  Experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  User         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([experienceId])
}

model OrderCharge {
  id            String            @id @default(cuid())
  publicId      String
  orderId       String
  code          String            @unique
  price         Int
  totalAmount   Int
  status        OrderChargeStatus
  paymentMethod String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  userId        String?
  cartId        String?
  Cart          Cart?             @relation(fields: [cartId], references: [id])
  User          User?             @relation(fields: [userId], references: [id])
  Payment       Payment[]

  @@unique([createdAt, userId, cartId])
  @@index([cartId])
  @@index([createdAt])
  @@index([userId])
}

enum OrderChargeStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model Payment {
  id            String      @id @default(cuid())
  publicId      String      @unique @default(cuid())
  code          String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  orderChargeId String
  OrderCharge   OrderCharge @relation(fields: [orderChargeId], references: [id])
  refound       Refound[]
  inflows       Inflow[]
  outflow       Outflow[]

  @@index([orderChargeId])
  @@index([publicId])
  @@index([code])
}

model Person {
  id                     String            @id @default(cuid())
  publicId               String            @unique @default(cuid())
  code                   String            @unique
  fullName               String?
  birthDate              String? //DateTime
  isPersonWithDisability Boolean?
  additionalInfo         String?
  documentType           String?
  documentCode           String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt
  documentUrl            String?
  personPhoneId          String?
  PersonPhone            PersonPhone?
  purchasedTicket        PurchasedTicket[]

  // paymentId              String 
  // payment   Payment @relation(fields: [paymentId], references: [id])
  @@unique([documentType, documentCode])
  @@index([personPhoneId])
  @@index([documentType])
  @@index([documentCode])
}

model PersonPhone {
  id        String   @id @default(cuid())
  contry    String
  area      String
  number    String
  type      String?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  personId  String   @unique
  Person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model PurchasedExperience {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  experienceId String?
  userId       String?
  Experience   Experience? @relation(fields: [experienceId], references: [id])

  User            User?             @relation(fields: [userId], references: [id])
  PurchasedTicket PurchasedTicket[]
  Review          Review[]

  @@index([experienceId])
  @@index([userId])
}

model PurchasedTicket {
  id                        String              @id @default(cuid())
  publicId                  String              @unique @default(cuid())
  code                      String              @unique
  isForPersonWithDisability Boolean
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now()) @updatedAt
  type                      String
  userId                    String?
  personId                  String?
  purchasedExperienceId     String
  experienceId              String?
  Experience                Experience?         @relation(fields: [experienceId], references: [id])
  Person                    Person?             @relation(fields: [personId], references: [id])
  PurchasedExperience       PurchasedExperience @relation(fields: [purchasedExperienceId], references: [id])
  User                      User?               @relation(fields: [userId], references: [id])
  coupons                   Coupon[]

  @@index([publicId])
  @@index([code])
  @@index([userId])
  @@index([experienceId])
}

model Refound {
  id        String   @id @default(cuid())
  reason    String
  type      String?
  createdAt DateTime @default(now())
  // saleId    String  
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  // payment payment[]

  @@index([paymentId])
}

model MarketingCampaign {
  id        String         @id @default(cuid())
  name      String
  channels  String
  startDate DateTime
  endDate   DateTime
  status    CampaignStatus @default(PENDING)
  budget    Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Inflow {
  id          String   @id @default(cuid())
  description String
  value       Decimal
  type        String?
  status      String?
  createdAt   DateTime @default(now())
  // saleId    String  
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Setting {
  id              String    @id @default(cuid())
  businessName    String    @unique
  docs            String
  businessAddress String?
  businessEmail   String?
  businessPhone   String?
  operatingHours  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  contry          Country?
  idiom           Idiom?
  currency        Currency?
}

model AccountSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  newsletter         Boolean @default(true)

  // showEmail             Boolean @default(false)
  // showPhone             Boolean @default(false)
  // showProfile           Boolean @default(true)
  twoFactorEnabled Boolean @default(false)

  language String @default("en")
  theme    String @default("light")
  timezone String @default("UTC")

  deactivateAccount Boolean @default(false)
  deleteRequested   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessSettings {
  id          String   @id @default(cuid())
  companyName String
  legalName   String?
  taxId       String?
  industry    String?
  email       String?
  phone       String?
  website     String?
  street      String?
  number      String?
  city        String?
  state       String?
  zip         String?
  country     String?
  taxRegime   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Country {
  BRAZIL
  ARGENTINA
  USA
}

enum Idiom {
  PT_BR
  ES_AR
  EN_US
}

enum Currency {
  BRL
  ARS
  USD
}

model Schedule {
  id        String   @id @default(cuid())
  title     String
  type      String
  date      DateTime
  time      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model GrowUp {
  id String @id @default(cuid())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  requestDate String
  amount      String
  purpose     String
  status      String
}

model Sponsor {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  website     String?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tasks {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  responsible String
  data        String
  state       String
}

model Outflow {
  id          String   @id @default(cuid())
  description String
  value       Decimal
  type        String?
  status      String?
  createdAt   DateTime @default(now())

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])
  // saleId    String  

  @@index([paymentId])
}

model Review {
  id                    String              @id @default(cuid())
  rating                Int
  comment               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  userId                String?
  purchasedExperienceId String
  PurchasedExperience   PurchasedExperience @relation(fields: [purchasedExperienceId], references: [id], onDelete: Cascade)
  User                  User?               @relation(fields: [userId], references: [id])

  @@unique([userId, purchasedExperienceId])
  @@index([purchasedExperienceId])
  @@index([userId])
}

