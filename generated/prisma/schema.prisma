enum DiscountType {
  PERCENTAGE
  CURRENCY_VALUE
}

enum SuportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
}

enum SuportTicketSubject {
  TECHNICAL_ISSUE
  BILLING
  ACCOUNT_ACCESS
  FEATURE_REQUEST
  BUG_REPORT
  FEEDBACK
  GENERAL_INQUIRY
  CANCELLATION
  REFUND
  OTHER
}

