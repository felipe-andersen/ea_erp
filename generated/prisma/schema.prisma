model VolumeCategory {
  id          String      @id @default(cuid())
  name        String      @unique //A33 (22kg)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Inventory   Inventory[]
}

model Inventory {
  id               String         @id @default(cuid())
  volumeCategoryId String
  // quantity  Int
  // location  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  // purchasedTicketId String?
  // purchasedTicket   PurchasedTicket? @relation(fields: [purchasedTicketId], references: [id])
  volumeCategory   VolumeCategory @relation(fields: [volumeCategoryId], references: [id], onDelete: Cascade)
}

model GatewayCharge {
  id          String   @id @default(cuid())
  provider    String
  providerId  String
  rawResponse Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
